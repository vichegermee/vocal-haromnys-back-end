# Copy to .env and export its contents (or set these as real environment
# variables in your run configuration) before running ./mvnw spring-boot:run.
# See application.yml for how each is consumed — this project has no dotenv
# loading library, Spring reads real OS environment variables via
# ${VAR:default} placeholders. Never commit a filled-in .env.

DB_URL=jdbc:postgresql://localhost:5433/vocal_harmonys
DB_USERNAME=vocal_harmonys
DB_PASSWORD=vocal_harmonys

JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Stripe Dashboard > Developers > API keys (use a test-mode key locally)
STRIPE_SECRET_KEY=
# `stripe listen` prints this locally; Dashboard > Developers > Webhooks in production
STRIPE_WEBHOOK_SECRET=
# The frontend's own origin, used to build Stripe's success/cancel redirect URLs
FRONTEND_BASE_URL=http://localhost:5175

# Resend Dashboard > API Keys
RESEND_API_KEY=
# Must be on a domain verified in Resend, or the sandbox sender below
RESEND_FROM_ADDRESS=onboarding@resend.dev
# Where reservation/join-application/paid-donation recap emails are sent
ADMIN_NOTIFICATION_EMAIL=viche.germee@gmail.com
